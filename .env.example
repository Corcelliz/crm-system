# Copie para .env e ajuste conforme necessário.

# Porta e interface do servidor HTTP
PORT=3000
HOST=127.0.0.1

# Em produção, defina NODE_ENV=production para ativar cookies "Secure" (exige HTTPS)
NODE_ENV=development

# Segredo usado para assinar os tokens de sessão (mínimo 32 caracteres).
# Se não for definido, um segredo aleatório é gerado e guardado em data/jwt-secret.key
# JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Pasta onde ficam o banco SQLite e o segredo gerado
# DATA_DIR=./data
